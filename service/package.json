{
  "name": "wiredog-vpn-service",
  "version": "2.0.0",
  "description": "WireDog VPN Linux Service - Backend daemon for VPN management",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "esbuild": "^0.27.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
