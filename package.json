{
  "name": "wiredog-vpn-linux",
  "productName": "WireDogVPN",
  "private": true,
  "version": "1.0.0",
  "buildNumber": 1,
  "description": "WireDog VPN for Linux — Privacy, Freedom, Trust",
  "main": "electron/main.js",
  "homepage": "https://wiredogvpn.com",
  "author": "WireDog Technologies, LLC <rj@wiredogvpn.com> (https://wiredogvpn.com)",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"sleep 2 && npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:electron:only": "cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:service": "cd service && npm run build",
    "build:production": "npm run build:service && cross-env NODE_ENV=production npm run build && cross-env NODE_ENV=production electron-builder --linux",
    "package": "npm run build && electron-builder",
    "package:deb": "npm run build:production",
    "package:linux": "npm run build && electron-builder --linux",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "electron-log": "^5.0.0",
    "electron-store": "^11.0.2",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/electron": "^1.6.10",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19"
  }
}
